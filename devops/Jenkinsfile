/*
  Practica 2 - Jenkinsfile dummy (PUNTO DE PARTIDA)

  Este Jenkinsfile es intencionalmente simple. En la Practica 2 iras anadiendo
  piezas (stages, agents, funciones Groovy, Docker build, docker compose, etc.)
  hasta construir un pipeline CI/CD completo.
*/

// Función reutilizable para ejecutar comandos dentro de un contenedor Docker.
def runInDocker(String image, Closure body) {
  docker.image(image).inside {
    body()
  }
}

pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

  stages {
    // Stage 1: Muestra información básica sobre la ejecución.
    stage('Info') {
      steps {
        sh 'echo "Job: ${JOB_NAME}"'
        sh 'echo "Build: ${BUILD_NUMBER}"'
      }
    }

    // Construye la imagen Docker de la aplicación.
    stage('Build image') {
        steps {
            // El bloque 'script' permite usar código Groovy más complejo.
            script {
                def imageName = "${JOB_NAME}:${BUILD_NUMBER}".toLowerCase()
                echo "Building and tagging image: ${imageName}"
                // Ejecuta 'docker build' para crear la imagen.
                docker.build(imageName, "--build-arg VERSION=${BUILD_NUMBER} -f devops/Dockerfile .")
            }
        }
    }

    stage('Lint') {
      steps {
        runInDocker('maven:3.8.6-openjdk-11-slim') {
          sh '''
            apt-get update && apt-get install -y make
            make lint
          '''
        }
      }
    }

    stage('Test') {
      steps {
        runInDocker('maven:3.8.6-openjdk-11-slim') {
          sh '''
            apt-get update && apt-get install -y make
            make test
          '''
        }
      }
    }

  }
}
